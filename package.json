{
  "name": "token-app",
  "productName": "Token Lens",
  "version": "0.1.5",
  "description": "统一查看各家 API 余额与 coding plan 余量的桌面应用",
  "author": "xian4840-cloud",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xian4840-cloud/token-lens.git"
  },
  "private": true,
  "main": "electron-dist/main.js",
  "scripts": {
    "dev:ui": "vite",
    "dev:electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:run": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k -n tsc,vite,app \"npm:dev:electron:watch\" \"npm:dev:ui\" \"npm:dev:electron:run\"",
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:electron && npm run build:ui",
    "dist:portable": "npm run build && electron-builder --dir --config electron-builder-portable.yml",
    "dist:installer": "npm run build && electron-builder --config electron-builder-installer.yml",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck": "npm run typecheck:ui && npm run typecheck:electron && npm run typecheck:test",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:signing": "node scripts/verify-acs3.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^2.5.5",
    "undici": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
