{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022"],
    "outDir": "electron-dist",
    // rootDir 取仓库根：主进程与界面共用的 shared/ 一并编译，
    // 产物为 electron-dist/electron/** 与 electron-dist/shared/**（package.json main 随之指向 electron-dist/electron/main.js）
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts"],
  // 测试文件不参与主进程构建：否则 electron-dist 下会生成 *.test.js，
  // 被 electron-builder 一并打进安装包，而它们 import 的 vitest 只是 devDependency，
  // 用户机上一旦被加载就是 MODULE_NOT_FOUND。
  // 它们的类型检查交给 tsconfig.test.json。
  "exclude": ["electron/**/*.test.ts", "electron/**/*.spec.ts", "shared/**/*.test.ts"]
}
